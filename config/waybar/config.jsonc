 {
    "layer": "top",
    "output": ["*"],
    "position": "top",
    "mod": "dock",
    "height": 28,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "include": ["~/.config/waybar/modules.jsonc"],

    "modules-left": ["group/pill#left1", "group/pill#left2", "group/pill#left3", "group/pill#left4"],
    "group/pill#left1": {
      "orientation": "inherit",
      "modules": ["custom/launcher"]
    },
    "group/pill#left2": {
      "orientation": "inherit",
      "modules": ["hyprland/workspaces#kanji", "custom/spacer", "hyprland/window"]
    },
    "group/pill#left3": {
      "orientation": "inherit",
      "modules": ["group/expandPerformance"]
    },

    "group/pill#left4": {
      "orientation": "inherit",
      "modules": ["group/expandTray"]
    },

    "modules-center": ["group/pill#center"],
    "group/pill#center": {
      "orientation": "inherit",
      "modules": ["idle_inhibitor", "clock", "custom/spacer", "custom/pacman"]
    },

    "modules-right": ["group/pill#right1", "group/pill#right2"],
    "group/pill#right1": {
      "orientation": "inherit",
      "modules": ["mpd"]
    },
    "group/pill#right2": {
      "orientation": "inherit",
      "modules": ["group/expand", "group/volume", "group/power"]
      }
  }

